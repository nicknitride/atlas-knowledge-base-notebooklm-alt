# Copy to .env for Docker Compose. Do not commit provider API keys.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-before-exposing
ATLAS_DATABASE_PASSWORD=change-me-before-exposing
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8080

# Local-first (default): Ollama-compatible endpoint — no cloud keys required
ATLAS_PROVIDER_TYPE=local
ATLAS_OLLAMA_URL=http://host.docker.internal:11434
ATLAS_OLLAMA_MODEL=llama3
ATLAS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ATLAS_OLLAMA_EMBEDDING_DIMENSIONS=768

# Upload limit (bytes). Default 80 MiB.
ATLAS_MAX_UPLOAD_BYTES=83886080
# Spring multipart limit should match (e.g. 80MB)
ATLAS_MAX_UPLOAD=80MB

# Optional cloud providers (opt-in only)
# ATLAS_PROVIDER_TYPE=gemini
# ATLAS_GEMINI_API_KEY=
# ATLAS_GEMINI_MODEL=gemini-3.5-flash
# ATLAS_PROVIDER_TYPE=openai
# ATLAS_OPENAI_API_KEY=
# ATLAS_OPENAI_MODEL=gpt-4o-mini
